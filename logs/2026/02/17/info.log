CREATE TABLE gen_table_column (
	column_id BIGINT NOT NULL COMMENT '编号' AUTO_INCREMENT, 
	table_id BIGINT COMMENT '归属表编号', 
	column_name VARCHAR(200) COMMENT '列名称', 
	column_comment VARCHAR(500) COMMENT '列描述', 
	column_type VARCHAR(100) COMMENT '列类型', 
	python_type VARCHAR(500) COMMENT 'PYTHON类型', 
	python_field VARCHAR(200) COMMENT 'PYTHON字段名', 
	is_pk CHAR(1) COMMENT '是否主键（1是）', 
	is_increment CHAR(1) COMMENT '是否自增（1是）', 
	is_required CHAR(1) COMMENT '是否必填（1是）', 
	is_unique CHAR(1) COMMENT '是否唯一（1是）', 
	is_insert CHAR(1) COMMENT '是否为插入字段（1是）', 
	is_edit CHAR(1) COMMENT '是否编辑字段（1是）', 
	is_list CHAR(1) COMMENT '是否列表字段（1是）', 
	is_query CHAR(1) COMMENT '是否查询字段（1是）', 
	query_type VARCHAR(200) COMMENT '查询方式（等于、不等于、大于、小于、范围）' DEFAULT 'EQ', 
	html_type VARCHAR(200) COMMENT '显示类型（文本框、文本域、下拉框、复选框、单选框、日期控件）', 
	dict_type VARCHAR(200) COMMENT '字典类型' DEFAULT '''''', 
	sort INTEGER COMMENT '排序', 
	create_by VARCHAR(64) COMMENT '创建者' DEFAULT '''''', 
	create_time DATETIME COMMENT '创建时间', 
	update_by VARCHAR(64) COMMENT '更新者' DEFAULT '''''', 
	update_time DATETIME COMMENT '更新时间', 
	PRIMARY KEY (column_id)
)COMMENT='代码生成业务表字段'


