CREATE TABLE sys_menu (
	menu_id BIGINT NOT NULL COMMENT '菜单ID' AUTO_INCREMENT, 
	menu_name VARCHAR(50) NOT NULL COMMENT '菜单名称', 
	parent_id BIGINT COMMENT '父菜单ID' DEFAULT '0', 
	order_num INTEGER COMMENT '显示顺序' DEFAULT '0', 
	path VARCHAR(200) COMMENT '路由地址' DEFAULT '''''', 
	component VARCHAR(255) COMMENT '组件路径', 
	query VARCHAR(255) COMMENT '路由参数', 
	route_name VARCHAR(50) COMMENT '路由名称' DEFAULT '''''', 
	is_frame INTEGER COMMENT '是否为外链（0是 1否）' DEFAULT '1', 
	is_cache INTEGER COMMENT '是否缓存（0缓存 1不缓存）' DEFAULT '0', 
	menu_type CHAR(1) COMMENT '菜单类型（M目录 C菜单 F按钮）' DEFAULT '', 
	visible CHAR(1) COMMENT '菜单状态（0显示 1隐藏）' DEFAULT '0', 
	status CHAR(1) COMMENT '菜单状态（0正常 1停用）' DEFAULT '0', 
	perms VARCHAR(100) COMMENT '权限标识', 
	icon VARCHAR(100) COMMENT '菜单图标' DEFAULT '#', 
	create_by VARCHAR(64) COMMENT '创建者' DEFAULT '''''', 
	create_time DATETIME COMMENT '创建时间', 
	update_by VARCHAR(64) COMMENT '更新者' DEFAULT '''''', 
	update_time DATETIME COMMENT '更新时间', 
	remark VARCHAR(500) COMMENT '备注' DEFAULT '''''', 
	PRIMARY KEY (menu_id)
)COMMENT='菜单权限表'


