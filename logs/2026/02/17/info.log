CREATE TABLE gen_table (
	table_id BIGINT NOT NULL COMMENT '编号' AUTO_INCREMENT, 
	table_name VARCHAR(200) COMMENT '表名称' DEFAULT '''''', 
	table_comment VARCHAR(500) COMMENT '表描述' DEFAULT '''''', 
	sub_table_name VARCHAR(64) COMMENT '关联子表的表名', 
	sub_table_fk_name VARCHAR(64) COMMENT '子表关联的外键名', 
	class_name VARCHAR(100) COMMENT '实体类名称' DEFAULT '''''', 
	tpl_category VARCHAR(200) COMMENT '使用的模板（crud单表操作 tree树表操作）' DEFAULT 'crud', 
	tpl_web_type VARCHAR(30) COMMENT '前端模板类型（element-ui模版 element-plus模版）' DEFAULT '''''', 
	package_name VARCHAR(100) COMMENT '生成包路径', 
	module_name VARCHAR(30) COMMENT '生成模块名', 
	business_name VARCHAR(30) COMMENT '生成业务名', 
	function_name VARCHAR(50) COMMENT '生成功能名', 
	function_author VARCHAR(50) COMMENT '生成功能作者', 
	gen_type CHAR(1) COMMENT '生成代码方式（0zip压缩包 1自定义路径）' DEFAULT '0', 
	gen_path VARCHAR(200) COMMENT '生成路径（不填默认项目路径）' DEFAULT '/', 
	options VARCHAR(1000) COMMENT '其它生成选项', 
	create_by VARCHAR(64) COMMENT '创建者' DEFAULT '''''', 
	create_time DATETIME COMMENT '创建时间', 
	update_by VARCHAR(64) COMMENT '更新者' DEFAULT '''''', 
	update_time DATETIME COMMENT '更新时间', 
	remark VARCHAR(500) COMMENT '备注', 
	PRIMARY KEY (table_id)
)COMMENT='代码生成业务表'


