CREATE TABLE sys_job (
	job_id BIGINT NOT NULL COMMENT '任务ID' AUTO_INCREMENT, 
	job_name VARCHAR(64) NOT NULL COMMENT '任务名称' DEFAULT '''''', 
	job_group VARCHAR(64) NOT NULL COMMENT '任务组名' DEFAULT 'default', 
	job_executor VARCHAR(64) COMMENT '任务执行器' DEFAULT 'default', 
	invoke_target VARCHAR(500) NOT NULL COMMENT '调用目标字符串', 
	job_args VARCHAR(255) COMMENT '位置参数' DEFAULT '''''', 
	job_kwargs VARCHAR(255) COMMENT '关键字参数' DEFAULT '''''', 
	cron_expression VARCHAR(255) COMMENT 'cron执行表达式' DEFAULT '''''', 
	misfire_policy VARCHAR(20) COMMENT '计划执行错误策略（1立即执行 2执行一次 3放弃执行）' DEFAULT '3', 
	concurrent CHAR(1) COMMENT '是否并发执行（0允许 1禁止）' DEFAULT '1', 
	status CHAR(1) COMMENT '状态（0正常 1暂停）' DEFAULT '0', 
	create_by VARCHAR(64) COMMENT '创建者' DEFAULT '''''', 
	create_time DATETIME COMMENT '创建时间', 
	update_by VARCHAR(64) COMMENT '更新者' DEFAULT '''''', 
	update_time DATETIME COMMENT '更新时间', 
	remark VARCHAR(500) COMMENT '备注信息' DEFAULT '''''', 
	PRIMARY KEY (job_id, job_name, job_group)
)COMMENT='定时任务调度表'


